[Unit]
Description=Multisnake game server
After=network.target

[Service]
Type=simple
User=multisnake
Group=multisnake
WorkingDirectory=/opt/multisnake
ExecStart=/usr/bin/node /opt/multisnake/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
# Basic hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
