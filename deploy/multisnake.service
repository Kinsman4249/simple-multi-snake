[Unit]
Description=Multisnake game server
After=network.target

[Service]
Type=simple
User=multisnake
Group=multisnake
WorkingDirectory=/opt/multisnake
# Optional (leading "-"): supplies ADMIN_TOKEN for POST /api/admin/
# notify-shutdown, the maintenance-warning broadcast install.sh sends before
# restarting. Written by install-lib/service.sh's resolve_admin_token.
EnvironmentFile=-/etc/multisnake/admin.env
ExecStart=/opt/multisnake/multisnake-server
Restart=on-failure
RestartSec=3
# Basic hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
