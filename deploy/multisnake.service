[Unit]
Description=Multisnake game server
After=network.target

[Service]
Type=simple
User=multisnake
Group=multisnake
WorkingDirectory=/opt/multisnake
ExecStart=/opt/multisnake/multisnake-server
Restart=on-failure
RestartSec=3
# Basic hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
